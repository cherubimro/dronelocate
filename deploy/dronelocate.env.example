# Shared settings for every node on this host -> /etc/default/dronelocate
# deploy.sh writes this file; it is here so the contents are reviewable.

# The supernode. This is the one value that must change from the defaults:
# zconf.spoke() defaults to 127.0.0.1, which is right for a single-box demo
# and wrong for every distributed one.
HUB=192.168.1.10
PORT=7447

# Must be byte-identical on every node and on the supernode. Nodes look up
# their own surveyed position in it, and the solver trusts those positions
# 1:1 -- a node whose config disagrees about where it is will correlate
# beautifully and still lie, which is precisely the failure Huber loss
# exists to catch and cannot diagnose.
CONFIG=config/site.json

# Which interpreter. On Debian/Raspberry Pi OS the system python3 has both
# apt's python3-uhd and pip's zenoh, so /usr/bin/python3 is right. On Ubuntu
# with a virtualenv, point at the venv's python -- and note the venv must
# have been created with --system-site-packages or it cannot see apt's uhd.
PYTHON=/usr/bin/python3

# Default for nodes without a per-node override.
SOURCE=sim

# --- per-node override -> /etc/default/dronelocate-n10 --------------------
# Only the differences. This is how one fleet mixes emulated nodes with a
# real radio:
#
#     SOURCE=uhd
#     CONFIG=config/site-mixed-b210.json
#
# Remember the bench profile sets require_gps=false and a 5 s timeout; with
# a stock config a board without a GPS antenna waits 180 s and then dies.
